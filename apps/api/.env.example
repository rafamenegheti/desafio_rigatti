NODE_ENV=development
PORT=3333

# MongoDB. Sem Mongo instalado? Rode `npm run db:memory` na raiz (sobe um Mongo em memória nessa porta)
MONGODB_URI=mongodb://127.0.0.1:27017/mini_saas

# Gere um segredo forte: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d

# Origem do frontend permitida no CORS (separe por vírgula para mais de uma)
CORS_ORIGIN=http://localhost:5173

# Agente de IA: "anthropic" usa Claude de verdade; "mock" roda sem chave (apenas para demo/testes)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
